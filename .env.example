# Copy to .env.local for development. Never commit real values.
# In Netlify, set these per-context (dev / uat / production) in Site settings > Environment variables.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Newer Firebase projects use a "<project-id>.firebasestorage.app" default
# bucket instead of the older "<project-id>.appspot.com" — copy whichever
# your project's console actually shows (Storage tab).
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
